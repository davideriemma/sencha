@startuml component_diagram
' Architettura minima LiteX per il BSP Zephyr - diagramma dei componenti UML.
' Sorgente del diagramma; component_diagram.svg ne e' la versione gia' renderizzata.
' Rendering: plantuml -tsvg component_diagram.puml

skinparam componentStyle uml2
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Helvetica

title Architettura minima per il BSP Zephyr - diagramma dei componenti

component "SoC minimo LiteX (2026.08)" <<subsystem>> as SOC {

    component "VexRiscv (standard)\nRV32IM, cache I/D\nreset @ 0x0000_0000" <<soft-core>> as CPU
    component "CRG\ndominio sys (clk, rst)" <<clock/reset>> as CRG

    component "Bus Firewall" <<previsto>> as FW #white;line.dashed

    component "Bus Wishbone 32 bit\nInterconnectShared:\narbiter + decoder + timeout" <<interconnect>> as WB

    component "ROM\n0x0000_0000 - 128 KiB\nBIOS LiteX" <<memory>> as ROM
    component "SRAM\n0x1000_0000 - 8 KiB\nstack/dati BIOS" <<memory>> as SRAM
    component "MAIN_RAM\n0x4000_0000 - 64 KiB\nimmagine Zephyr" <<memory>> as RAM
    component "Wishbone2CSR\n0xF000_0000 - 64 KiB\nCSR 32 bit" <<bridge>> as BRIDGE

    component "Bus CSR\n32 bit, paging 0x800" <<interconnect>> as CSR

    component "SoCController (ctrl)\n0xF000_0000\nreset, scratch, bus_errors" <<peripheral>> as CTRL
    component "Identifier\n0xF000_0800" <<peripheral>> as IDENT
    component "Timer (timer0)\n0xF000_1000 - IRQ 1\ncon uptime (64 bit)" <<peripheral>> as TIMER
    component "UART (uart)\n0xF000_1800 - IRQ 0\n115200 8N1" <<peripheral>> as UART

    component "Bridge Wishbone -> TL-UL" <<previsto>> as TLUL #white;line.dashed
    component "IP OpenTitan (TL-UL)" <<previsto>> as OT #white;line.dashed
}

interface "serial (tx/rx)" as SERIAL

CPU  --> FW   : ibus, dbus\n(Wishbone master)
FW   --> WB
WB   --> ROM
WB   --> SRAM
WB   --> RAM
WB   --> BRIDGE
WB   ..> TLUL
TLUL ..> OT

BRIDGE --> CSR
CSR  --> CTRL
CSR  --> IDENT
CSR  --> TIMER
CSR  --> UART

TIMER -[#B00020]-> CPU : IRQ 1
UART  -[#B00020]-> CPU : IRQ 0
UART  -- SERIAL

CRG ..> CPU : clk, rst

note bottom of SOC
  Linea continua: componente implementato (minimal_soc.py).
  Linea tratteggiata: estensione prevista.
  Clock: 1 MHz in simulazione (Verilator), 24 MHz su Olimex GateMate A1-EVB.
end note

@enduml
